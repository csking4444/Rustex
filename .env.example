# Variables consumed by docker-compose.yml (docker compose reads a file named ".env"
# in this same directory automatically). Copy this to .env and fill in real values —
# do not commit the real .env.

# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback
DISCORD_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/callback

# Required. Rust+ credentials are stored AES-GCM encrypted and the API refuses to start
# without this, rather than failing later at the moment a user tries to pair.
# Generate with: openssl rand -base64 32
ENCRYPTION_FIELD_KEY=

FRONTEND_ORIGIN=http://localhost:5173

# ---------- Billing (Stripe) ----------
# Optional. Leave blank and the API still runs: /api/billing/plans reports purchasable:false
# and the UI says checkout is not connected, instead of offering a button that cannot work.
#
# Test-mode keys (sk_test_… / whsec_…) exercise the whole flow without moving real money.
# Get them from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint. The webhook is the only unauthenticated
# state-changing endpoint in the API — its security is entirely this signature check, so it
# refuses to process anything while this is unset.
# Local: stripe listen --forward-to localhost:8080/api/billing/webhook  (prints the secret)
# Deployed: https://dashboard.stripe.com/test/webhooks -> add endpoint -> signing secret
STRIPE_WEBHOOK_SECRET=

# Price ids from your own Stripe account (Products -> pricing). These differ per account and
# per mode, so they cannot be defaulted. Amounts must match PlanCatalog:
#   Scout $4.99/mo · $49.90/yr    Raider $9.99/mo · $99.90/yr    Clan $19.99/mo · $199.90/yr
# Stripe is the source of truth for what is actually charged — if they disagree, the customer
# is charged Stripe's number.
STRIPE_PRICE_SCOUT_MONTHLY=
STRIPE_PRICE_SCOUT_YEARLY=
STRIPE_PRICE_RAIDER_MONTHLY=
STRIPE_PRICE_RAIDER_YEARLY=
STRIPE_PRICE_CLAN_MONTHLY=
STRIPE_PRICE_CLAN_YEARLY=

# ---------- Complimentary access ----------
# Grants a plan without payment, by SteamID. Replaces the static site's COMPED_ACCOUNTS.
# Applied at startup and again on each Steam login, so it works whether configured before or
# after that account first signs in. Tier must be scout, raider or clan (lowercase).
#
# A grant never overwrites a paid subscription — if the account is paying, it is left alone.
COMP_STEAM_ID=76561199037012229
COMP_TIER=clan
COMP_REASON=storm account

COMP_STEAM_ID_2=76561199373420447
COMP_TIER_2=clan
COMP_REASON_2=granted access

# For a third and beyond, add Billing__ComplimentaryGrants__2__SteamId etc. directly on the host
# (docker-compose only wires the two slots above). Numbering must be contiguous from 0.
