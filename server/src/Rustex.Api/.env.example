# Copy to .env in this same folder for local `dotnet run`, or let docker-compose load it directly.
# These override the matching keys in appsettings.json (Program.cs maps them at startup).

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=rustex;Username=rustex;Password=changeme
ConnectionStrings__Redis=localhost:6379

# Generate with: openssl rand -base64 48
Jwt__SigningKey=

# Discord Developer Portal -> your application -> OAuth2
Discord__ClientId=
Discord__ClientSecret=
Discord__RedirectUri=https://localhost:5443/api/auth/discord/callback
Discord__FrontendCallbackUrl=http://localhost:5173/auth/callback

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
Google__ClientId=
Google__ClientSecret=
Google__RedirectUri=https://localhost:5443/api/auth/google/callback
Google__FrontendCallbackUrl=http://localhost:5173/auth/callback

# Steam OpenID needs NO API key — sign-in works with these three URLs alone. The key is only
# used to fetch a nicer display name and avatar; without it users get a "SteamUser123456"
# placeholder they can rename. Free key: https://steamcommunity.com/dev/apikey
# ReturnUrl must exactly match the origin the browser reaches this API on — Steam signs
# return_to and the callback rejects a mismatch. Set Steam__Enabled=false to hide Steam login.
Steam__Enabled=true
Steam__ApiKey=
Steam__ReturnUrl=https://localhost:5443/api/auth/steam/callback
Steam__Realm=https://localhost:5443
Steam__FrontendCallbackUrl=http://localhost:5173/auth/callback

# AES-256 key for encrypting phone numbers at rest. Generate with: openssl rand -base64 32
Encryption__FieldKey=

# VAPID keypair for Web Push (RFC 8292) — lets alerts reach a backgrounded/closed PWA, not just
# an open tab. Generate a pair with the WebPush package's VapidHelper.GenerateVapidKeys() (a
# throwaway console snippet), or `npx web-push generate-vapid-keys` if you have Node installed.
# Leave both empty to leave Web Push disabled — it's an optional channel (see
# docs/ARCHITECTURE.md#emergency-alerts-phase-4).
WebPush__PublicKey=
WebPush__PrivateKey=
WebPush__Subject=mailto:admin@example.com

# Rust+ auto-pairing listener. When enabled, the API holds an FCM push connection per user who
# has completed the one-time `rustex-pair` setup on their own machine, so pressing "Pair With
# Server" in game registers the server here automatically. See docs/RUSTPLUS.md.
# Manual pairing (POST .../rustplus/pairing) always works regardless of this setting.
RustPlus__EnableFcmListener=false
