# Copy to .env in this same folder for local `dotnet run`, or let docker-compose load it directly.
# These override the matching keys in appsettings.json (Program.cs maps them at startup).

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=rustex;Username=rustex;Password=changeme
ConnectionStrings__Redis=localhost:6379

# Generate with: openssl rand -base64 48
Jwt__SigningKey=

# Discord Developer Portal -> your application -> OAuth2
Discord__ClientId=
Discord__ClientSecret=
Discord__RedirectUri=https://localhost:5443/api/auth/discord/callback
Discord__FrontendCallbackUrl=http://localhost:5173/auth/callback

# AES-256 key for encrypting phone numbers at rest. Generate with: openssl rand -base64 32
Encryption__FieldKey=
