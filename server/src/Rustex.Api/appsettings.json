{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=rustex;Username=rustex;Password=changeme",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "rustex",
    "Audience": "rustex-client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Discord": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "https://localhost:5443/api/auth/discord/callback",
    "FrontendCallbackUrl": "http://localhost:5173/auth/callback"
  },
  "Google": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "https://localhost:5443/api/auth/google/callback",
    "FrontendCallbackUrl": "http://localhost:5173/auth/callback"
  },
  "Steam": {
    "ApiKey": "",
    "ReturnUrl": "https://localhost:5443/api/auth/steam/callback",
    "Realm": "https://localhost:5443",
    "FrontendCallbackUrl": "http://localhost:5173/auth/callback"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Encryption": {
    "FieldKey": ""
  },
  "Ingestion": {
    "EnableSimulator": true
  },
  "WebPush": {
    "PublicKey": "",
    "PrivateKey": "",
    "Subject": "mailto:admin@example.com"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1m", "Limit": 120 },
      { "Endpoint": "POST:/api/auth/*", "Period": "1m", "Limit": 10 }
    ]
  }
}
